---
import img1 from '../../assets/midjourney1.png';
import img2 from '../../assets/midjourney2.png';
import img3 from '../../assets/midjourney3.png';
import img4 from '../../assets/midjourney4.png';
import img5 from '../../assets/midjourney5.png';
import img6 from '../../assets/midjourney6.png';
import img7 from '../../assets/midjourney7.png';
import img8 from '../../assets/midjourney8.png';
import img9 from '../../assets/midjourney9.png';
import img10 from '../../assets/midjourney10.png';
import defaultImg from '../../assets/midjourney11.png';

import LRN from '../../assets/LRN_Logos.png';
import Bell from '../../assets/Bell.png';
import Bindo from '../../assets/Bindo_Logo.png';
import Sunline from '../../assets/Sunline.png';
import Midea from '../../assets/Midea.png';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const allImages = [img1, img2, img3, img4, img5, img6, img7, img8, img9, img10];

const workProjects = [
	{
		id: 'analytics',
		image: LRN,
		title: 'Learnosity',
		titleZh: '教育科技',
		description: 'Learnosity Assessment APIs | AI-enriched assessment solutions',
		descriptionZh: 'AI 赋能的测评解决方案',
		url: 'https://learnosity.com/',
	},
	{
		id: 'infra',
		image: Bindo,
		title: 'Bindo Labs',
		titleZh: '边度',
		description: 'The Omnichannel POS and Payment Solution',
		descriptionZh: '全渠道 POS 与支付解决方案',
		url: 'https://bindolabs.com/',
	},
	{
		id: 'payments',
		image: Bell,
		title: 'Bell.ai',
		titleZh: '少儿编程',
		description: 'Unlocking kids infinite potential through the joy of coding',
		descriptionZh: '寓教于乐学编程，激发少儿无限潜能',
		url: 'https://www.bell.ai/',
	},
	{
		id: 'design-system',
		image: Sunline,
		title: 'Sunline',
		titleZh: '银行系统',
		description: 'Lead the Development of Empowering Technologies and Innovation in the Financial Industry',
		descriptionZh: '引领金融行业技术赋能与创新发展',
		url: 'https://www.sunline-i.com/',
	},
	{
		id: 'Midea',
		image: Midea,
		title: 'Midea',
		titleZh: '美的',
		description: 'Intership in a global electrical appliance manufacturer',
		descriptionZh: '管培实习',
		url: 'https://www.midea.com/au/',
	},
];

const personalProjects = [
	{
		id: 'quokka',
		image: allImages[4],
		title: 'Quokka Blog',
		titleZh: 'Quokka 博客',
		description: 'A minimal, bilingual Astro blog theme with content collections and RSS support.',
		descriptionZh: '一个极简的双语 Astro 博客主题，支持内容集合和 RSS。',
		url: 'https://github.com/ardour100/Astro-Quokka',
	},
	{
		id: 'weather',
		image: allImages[5],
		title: 'Weather App',
		titleZh: '天气应用',
		description: 'A beautiful weather app with hourly forecasts, radar maps, and severe weather alerts.',
		descriptionZh: '一款精美的天气应用，支持逐小时预报、雷达地图和恶劣天气预警。',
		url: '#',
	},
	{
		id: 'chat',
		image: allImages[6],
		title: 'Chat Platform',
		titleZh: '聊天平台',
		description: 'Real-time messaging platform with end-to-end encryption, file sharing, and group chats.',
		descriptionZh: '实时通讯平台，支持端到端加密、文件共享和群聊。',
		url: '#',
	},
	{
		id: 'ecommerce',
		image: allImages[7],
		title: 'E-Commerce Store',
		titleZh: '电商商店',
		description: 'Full-stack online store with cart, checkout, payment integration, and admin dashboard.',
		descriptionZh: '全栈在线商店，包含购物车、结算、支付集成和管理后台。',
		url: '#',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} / Projects`} description="Projects and experiments." />
	</head>
	<body>
		<Header />
		<main class="projects-index">
			<div class="section-header">
				<span class="section-badge lang-en">Work</span>
				<span class="section-badge lang-zh">工作</span>
			</div>
			<section class="project-grid">
				{workProjects.map((project) => (
					<a class="project-card" href={project.url}>
						<div class="card-image">
							<img src={project.image.src} alt="" loading="lazy" class="project-img" data-id={project.id} onerror={'this.onerror=null;this.src=\'' + defaultImg.src + '\''} />
						</div>
						<div class="card-body">
							<h3 class="card-title">
								<span class="lang-en">{project.title}</span>
								<span class="lang-zh">{project.titleZh}</span>
							</h3>
							<p class="card-desc">
								<span class="lang-en">{project.description}</span>
								<span class="lang-zh">{project.descriptionZh}</span>
							</p>
						</div>
					</a>
				))}
			</section>
			<div class="section-header">
				<span class="section-badge lang-en">Personal</span>
				<span class="section-badge lang-zh">个人</span>
			</div>
			<section class="project-grid">
				{personalProjects.map((project) => (
					<a class="project-card" href={project.url}>
						<div class="card-image">
							<img src={project.image.src} alt="" loading="lazy" class="project-img" data-id={project.id} onerror={'this.onerror=null;this.src=\'' + defaultImg.src + '\''} />
						</div>
						<div class="card-body">
							<h3 class="card-title">
								<span class="lang-en">{project.title}</span>
								<span class="lang-zh">{project.titleZh}</span>
							</h3>
							<p class="card-desc">
								<span class="lang-en">{project.description}</span>
								<span class="lang-zh">{project.descriptionZh}</span>
							</p>
						</div>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-index {
		width: min(100% - 32px, 920px);
		margin: 0 auto;
		padding: 38px 0 72px;
	}

	.section-header {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
		padding-top: 8px;
	}

	.section-header + .section-header {
		margin-top: 48px;
	}

	.section-badge {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--muted));
		padding: 4px 12px;
		border-radius: 6px;
		background: rgba(var(--muted), 0.06);
		border: 1px solid rgba(var(--muted), 0.12);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
		text-decoration: none;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.9) inset,
			0 10px 24px rgba(83, 125, 150, 0.06),
			0 0 0 1px rgba(68, 161, 148, 0.04) inset;
		transition:
			transform 200ms ease,
			box-shadow 200ms ease;
	}

	.project-card:hover,
	.project-card:focus-visible {
		transform: translateY(-4px);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.95) inset,
			0 18px 36px rgba(83, 125, 150, 0.1),
			0 0 0 1px rgba(68, 161, 148, 0.06) inset;
		outline: none;
	}

	.project-card:active {
		transform: translateY(-1px);
	}

	.card-image {
		flex: 1;
		min-height: 0;
		width: 100%;
		overflow: hidden;
		background: rgb(var(--paper));
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 300ms ease;
	}

	.project-card:hover .card-image img,
	.project-card:focus-visible .card-image img {
		transform: scale(1.04);
	}

	.card-body {
		flex: 1;
		padding: 18px 20px 22px;
	}

	.card-title {
		margin: 0 0 6px;
		font-size: 1.1rem;
		font-weight: 650;
		color: rgb(var(--black));
		line-height: 1.35;
	}

	.project-card:hover .card-title,
	.project-card:focus-visible .card-title {
		color: rgb(var(--accent));
	}

	.card-desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}

	@media (max-width: 820px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 18px;
		}

		.section-header + .section-header {
			margin-top: 40px;
		}
	}

	@media (max-width: 520px) {
		.projects-index {
			padding: 28px 0 52px;
		}

		.project-grid {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.section-header + .section-header {
			margin-top: 36px;
		}

		.card-body {
			padding: 14px 16px 18px;
		}
	}
</style>
